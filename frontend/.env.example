# Supabaseプロジェクト > Project Settings > Database > Connection string
# サーバーレス環境(Vercel等)からはTransaction poolerの接続文字列(ポート6543)を推奨
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabaseプロジェクト > Project Settings > API から取得
# 顧客ログイン（Supabase Auth）に使用。ANON_KEYはブラウザに公開される前提のキー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY

# Stripeのシークレットキー（ダッシュボード > 開発者 > APIキー から取得）
# 開発中はテストモードのキー、本番公開時は本番用キーを設定してください。
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Webhookの署名検証用シークレット（/api/webhooks/stripe が使用）。
# ローカル開発: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# 実行時にターミナルへ表示される whsec_... をそのまま使用してください。
# 本番: ダッシュボード > 開発者 > Webhooks でエンドポイント追加後に発行される値を使用。
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# 決済完了後のリダイレクト先やStripeに渡す商品画像URLの組み立てに使用します。
# ローカル開発では未設定のままでもリクエストのOriginから自動判定されます。
# 本番環境では実際のドメインを設定してください。
NEXT_PUBLIC_SITE_URL=https://blmf.jp

# Supabaseプロジェクト > Project Settings > API から取得（"service_role" / "secret" キー）
# RLSを完全にバイパスする強い権限を持つため、絶対にNEXT_PUBLIC_を付けない・
# クライアントに渡さない・公開リポジトリにコミットしないこと。
# 商品画像アップロード(/admin/products)のバケット作成・書き込みと、
# 管理者アカウント作成スクリプト(npm run admin:create)にのみ使用。
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# 注文確認メール送信用のSMTP設定（自前のメールサーバーを含む任意のSMTPに対応）。
# ポート465はSSL/TLS、587等はSTARTTLSとして扱われます。
SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=weborder@soliton-cm.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
SMTP_FROM=weborder@soliton-cm.com
