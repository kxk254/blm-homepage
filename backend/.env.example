# 自前ホストのPostgres接続文字列。Postgres自体はdocker-composeの外(開発機・本番サーバー
# それぞれにネイティブインストールしたもの)で動かす前提なので、ホスト名はIPまたはドメインで指定する。
# 開発時はLAN上の開発機のIP、本番はサーバー自身のIP(同じマシンなら127.0.0.1でも可)を指定
DATABASE_URL=postgresql+asyncpg://blm:REPLACE_WITH_YOUR_PASSWORD@192.168.11.71:5432/blm

# セッションJWTの署名鍵。openssl rand -hex 32 などで生成した値に必ず差し替えること
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=43200

# StripeのシークレットキーとWebhook署名検証用シークレット
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# 注文確認メール送信用SMTP設定（既存のNext.js版と同じ値を使い回してよい）
SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=weborder@soliton-cm.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
SMTP_FROM=weborder@soliton-cm.com

# 決済リダイレクトやStripeに渡す画像URLの組み立てに使う自サイトのURL
SITE_URL=https://blmf.jp

# 商品画像を保存するNASマウントパス（コンテナ内から見えるパス。docker-composeでホストのNASマウント先をここにbindする）
MEDIA_ROOT=/mnt/media
